# EC-Sim 无特权容器镜像（**预构建二进制**变体，供无 registry 网络的验证机使用）
#
# 用法：先在宿主机 `cargo build --release -p esc-node`，然后：
#   podman build -f docker/Dockerfile.prebuilt -t ecsim-uds:prebuilt .
#   podman run --rm -v /tmp/ecsim-sock:/sock ecsim-uds:prebuilt --uds /sock/ecsim.sock --slaves 8
#
# 该变体只复制已构建的 `target/release/ec-sim-esc`，不联网、不需要 Rust 工具链；
# 标准多阶段构建见同目录 `Dockerfile`。基础镜像可用 `--build-arg BASE_IMAGE=...` 覆盖。
ARG BASE_IMAGE=docker.io/openeuler/openeuler:24.03-lts-sp4
FROM ${BASE_IMAGE}
COPY target/release/ec-sim-esc /usr/local/bin/ec-sim-esc
ENTRYPOINT ["/usr/local/bin/ec-sim-esc"]
CMD ["--uds", "/tmp/ecsim.sock"]
